# ============================================
# 全自动营销号短视频生成工厂 - 配置文件
# ============================================

# -------------------- LLM配置 --------------------
# Claude API (推荐用于文案生成)
ANTHROPIC_API_KEY=your_claude_api_key_here

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 通义千问 (国内推荐)
QWEN_API_KEY=your_qwen_api_key_here

# -------------------- 热点采集 --------------------
# 微博热搜API
WEIBO_API_KEY=your_weibo_api_key_here
WEIBO_COOKIE=your_weibo_cookie_here

# -------------------- 视频生成 --------------------
# HeyGen数字人API
HEYGEN_API_KEY=your_heygen_api_key_here

# Azure TTS (备选)
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=eastus

# -------------------- 图片生成 --------------------
# Replicate API (FLUX)
REPLICATE_API_TOKEN=your_replicate_token_here

# Stability AI (Stable Diffusion)
STABILITY_API_KEY=your_stability_api_key_here

# -------------------- 发布平台 --------------------
# 抖音开放平台
DOUYIN_CLIENT_KEY=your_douyin_client_key_here
DOUYIN_CLIENT_SECRET=your_douyin_client_secret_here
DOUYIN_ACCESS_TOKEN=your_douyin_access_token_here

# 快手开放平台
KUAISHOU_APP_ID=your_kuaishou_app_id_here
KUAISHOU_APP_SECRET=your_kuaishou_app_secret_here

# 视频号
WEIXIN_APP_ID=your_weixin_app_id_here
WEIXIN_APP_SECRET=your_weixin_app_secret_here

# -------------------- 其他配置 --------------------
# 工作目录
WORKING_DIR=./output

# 日志级别
LOG_LEVEL=INFO

# 并发数
MAX_WORKERS=5

# 视频质量
VIDEO_QUALITY=1080p
VIDEO_FPS=30
